PORT=4000
NODE_ENV=development
DATABASE_URL=file:./dev.db
# MUST equal frontend VITE_FIREBASE_PROJECT_ID
FIREBASE_PROJECT_ID=
# Replace with approved origins for each deployed environment
CORS_ORIGINS=http://localhost:5173
AI_PROVIDER=MOCK
PAYMENT_PROVIDER=STRIPE_MOCK
# No payment credentials required or supported for production through this integration.

# Sandbox ONLY. PAYMENTS_MODE=LIVE is intentionally unsupported.
PAYMENTS_MODE=DISABLED
# Required only when PAYMENTS_MODE=SANDBOX
FLW_SECRET_KEY=
FLW_WEBHOOK_SECRET=
# V3_HASH uses provider's verif-hash header; V4_HMAC uses flutterwave-signature.
FLW_WEBHOOK_MODE=V3_HASH
FLW_RETURN_URL=http://localhost:5173/payment/return

# Document vault (not configured by default; must use an isolated mounted volume).
DOCUMENT_VAULT_DIR=
DOCUMENT_VAULT_KEY_B64=
# Production safeguard requires explicit approval after security review.
DOCUMENT_VAULT_APPROVED=false
