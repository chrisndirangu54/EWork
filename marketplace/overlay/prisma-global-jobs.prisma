
/** Global cross-app job board. EWork and TeknTandao Workspace share Firebase identity. */
model GlobalJob {
  id             String                    @id @default(uuid())
  employerId     String
  title          String
  description    String
  skills         String
  category       String
  budgetCents    Int?
  currency       String                    @default("USD")
  location       String
  remote         Boolean                   @default(true)
  sourceRef      String?
  status         String                    @default("OPEN")
  selectedUserId String?
  createdAt      DateTime                  @default(now())
  updatedAt      DateTime                  @updatedAt
  applications   GlobalJobApplication[]
  milestones     GlobalJobMilestone[]
  messages       GlobalJobMessage[]
  updates        GlobalJobUpdate[]
  @@unique([employerId, sourceRef])
  @@index([status, createdAt])
  @@index([employerId, status])
  @@index([selectedUserId, status])
}

model GlobalJobApplication {
  id           String    @id @default(uuid())
  jobId        String
  job          GlobalJob @relation(fields: [jobId], references: [id], onDelete: Cascade)
  applicantId  String
  pitch        String
  bidCents     Int?
  status       String    @default("APPLIED")
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  @@unique([jobId, applicantId])
  @@index([applicantId, status])
}

model GlobalJobMilestone {
  id           String    @id @default(uuid())
  jobId        String
  job          GlobalJob @relation(fields: [jobId], references: [id], onDelete: Cascade)
  title        String
  status       String    @default("OPEN")
  submission   String?
  feedback     String?
  submittedAt  DateTime?
  approvedAt   DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  @@index([jobId, status])
}

model GlobalJobMessage {
  id          String    @id @default(uuid())
  jobId       String
  job         GlobalJob @relation(fields: [jobId], references: [id], onDelete: Cascade)
  authorId    String
  body        String
  createdAt   DateTime  @default(now())
  @@index([jobId, createdAt])
}

model GlobalJobUpdate {
  id          String    @id @default(uuid())
  jobId       String
  job         GlobalJob @relation(fields: [jobId], references: [id], onDelete: Cascade)
  authorId    String
  summary     String
  percent     Int
  createdAt   DateTime  @default(now())
  @@index([jobId, createdAt])
}
